---
const siteName = "SolarGuideUK";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SolarGuideUK — Home Solar Made Simple</title>
  <meta name="description" content="Independent guides on UK home solar panels, battery storage, and government grants." />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; }
    header { text-align: center; padding: 4rem 1.5rem 3rem; }
    header h1 { font-size: 2.2rem; color: #fbbf24; margin-bottom: 0.75rem; }
    header p { font-size: 1.1rem; color: #94a3b8; max-width: 500px; margin: 0 auto; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; padding: 2rem; max-width: 1000px; margin: 0 auto; }
    .card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 1.5rem; }
    .card h3 { color: #fbbf24; margin-bottom: 0.5rem; font-size: 1.1rem; }
    .card p { color: #cbd5e1; font-size: 0.95rem; line-height: 1.5; }
   footer { text-align: center; padding: 2rem; color: #64748b; font-size: 0.85rem; }
.hero-illustration { width: 100%; max-width: 500px; height: auto; margin: 2rem auto 0; display: block; border-radius: 16px; }
  </style>
</head>
<body>
  <header>
    <h1>☀️ Home Solar, Explained Simply</h1>
    <p>Independent, plain-English guides to help UK homeowners save money with solar panels and battery storage.</p>
	<svg viewBox="0 0 500 280" class="hero-illustration" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#38bdf8"/>
          <stop offset="100%" stop-color="#7dd3fc"/>
        </linearGradient>
        <linearGradient id="roof" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#dc4a3a"/>
          <stop offset="100%" stop-color="#b8382a"/>
        </linearGradient>
        <linearGradient id="panel" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1e3a5f"/>
          <stop offset="100%" stop-color="#2d5580"/>
        </linearGradient>
      </defs>

      <rect x="0" y="0" width="500" height="280" rx="16" fill="url(#sky)"/>

      <circle cx="405" cy="60" r="42" fill="#fde047"/>
      <g stroke="#fde047" stroke-width="4" stroke-linecap="round">
        <line x1="405" y1="0" x2="405" y2="15"/>
        <line x1="470" y1="60" x2="455" y2="60"/>
        <line x1="447" y1="18" x2="437" y2="28"/>
        <line x1="447" y1="102" x2="437" y2="92"/>
        <line x1="363" y1="18" x2="373" y2="28"/>
        <line x1="363" y1="102" x2="373" y2="92"/>
      </g>

      <ellipse cx="90" cy="70" rx="38" ry="20" fill="#ffffff" opacity="0.85"/>
      <ellipse cx="120" cy="60" rx="30" ry="17" fill="#ffffff" opacity="0.85"/>
      <ellipse cx="150" cy="200" rx="45" ry="22" fill="#ffffff" opacity="0.7"/>

      <rect x="0" y="230" width="500" height="50" fill="#4d7c3f"/>

      <rect x="140" y="150" width="220" height="100" fill="#f4e4c1"/>
      <polygon points="120,150 250,80 380,150" fill="url(#roof)"/>

      <g transform="translate(160,105) rotate(-16)">
        <rect x="0" y="0" width="46" height="26" fill="url(#panel)" stroke="#0f172a" stroke-width="1.5"/>
        <line x1="15" y1="0" x2="15" y2="26" stroke="#0f172a" stroke-width="1"/>
        <line x1="31" y1="0" x2="31" y2="26" stroke="#0f172a" stroke-width="1"/>
        <line x1="0" y1="13" x2="46" y2="13" stroke="#0f172a" stroke-width="1"/>
      </g>
      <g transform="translate(210,90) rotate(-16)">
        <rect x="0" y="0" width="46" height="26" fill="url(#panel)" stroke="#0f172a" stroke-width="1.5"/>
        <line x1="15" y1="0" x2="15" y2="26" stroke="#0f172a" stroke-width="1"/>
        <line x1="31" y1="0" x2="31" y2="26" stroke="#0f172a" stroke-width="1"/>
        <line x1="0" y1="13" x2="46" y2="13" stroke="#0f172a" stroke-width="1"/>
      </g>
      <g transform="translate(260,75) rotate(-16)">
        <rect x="0" y="0" width="46" height="26" fill="url(#panel)" stroke="#0f172a" stroke-width="1.5"/>
        <line x1="15" y1="0" x2="15" y2="26" stroke="#0f172a" stroke-width="1"/>
        <line x1="31" y1="0" x2="31" y2="26" stroke="#0f172a" stroke-width="1"/>
        <line x1="0" y1="13" x2="46" y2="13" stroke="#0f172a" stroke-width="1"/>
      </g>

      <rect x="220" y="180" width="60" height="70" fill="#7c9cbf"/>
      <line x1="250" y1="180" x2="250" y2="250" stroke="#0f172a" stroke-width="2"/>
      <line x1="220" y1="215" x2="280" y2="215" stroke="#0f172a" stroke-width="2"/>

      <rect x="170" y="200" width="35" height="50" fill="#fde68a" stroke="#0f172a" stroke-width="1.5"/>
      <line x1="170" y1="225" x2="205" y2="225" stroke="#0f172a" stroke-width="1"/>

      <rect x="60" y="240" width="10" height="30" fill="#5b3a29"/>
      <circle cx="65" cy="235" r="22" fill="#3f7d32"/>
      <circle cx="48" cy="245" r="16" fill="#4d8a3d"/>
      <circle cx="82" cy="245" r="16" fill="#4d8a3d"/>
    </svg>
  </header>

  <section class="cards">
    <a href="/best-solar-panels-2026" class="card"> 
      <h3>🔆 Best Solar Panels 2026</h3>
      <p>Compare the top-rated panels for UK homes, based on efficiency, warranty, and price.</p>
    </a>
    
	<a href="/uk-solar-grants" class="card">
      <h3>🏛️ UK Solar Grants</h3>
      <p>Find out which government schemes you qualify for and how much you could save.</p>
    </a>
    <a href="/battery-storage" class="card">
      <h3>🔋 Battery Storage</h3>
      <p>Should you add a battery? We break down the costs and payback time.</p>
    </a>
    <a href="/solar-panel-costs" class="card">
      <h3>💷 Solar Panel Costs</h3>
      <p>A full breakdown of installation costs, running savings, and payback periods.</p>
    </a>
    <a href="/is-my-home-suitable" class="card">
      <h3>🏠 Is My Home Suitable?</h3>
      <p>Roof type, direction, and shading — what actually matters for solar output.</p>
    </a>
    <a href="/how-to-get-started" class="card">
      <h3>📋 How to Get Started</h3>
      <p>A step-by-step guide to finding an installer and getting your first quote.</p>
    </a>
  </section>

  <footer>
    <p>© 2026 SolarGuideUK.co.uk — For informational purposes only. Not financial advice.</p>
  </footer>
</body>
</html>